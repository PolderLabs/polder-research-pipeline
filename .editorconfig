# .editorconfig — consistent editor settings (AUDIT.md P1)
#
# https://editorconfig.org/
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{py,js,ts,json,yaml,yml,toml,css,html,sh}]
indent_style = space
indent_size = 4

[*.{md,markdown}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
