{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polder.dev/schemas/task.schema.json",
  "title": "Task record",
  "description": "Authoritative workflow state for one unit of work (AUDIT.md §20, §15).",
  "type": "object",
  "required": ["id", "schema_version", "task_kind", "status", "role", "created_at", "summary"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^tsk_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "schema_version": {"type": "integer", "const": 1},
    "task_kind": {
      "enum": [
        "intake", "acquire", "process", "classify", "verify",
        "distill", "synthesize", "query", "maintain", "evolve",
        "decide", "plan"
      ]
    },
    "status": {
      "enum": [
        "pending", "leased", "in_progress", "awaiting_handoff",
        "completed", "failed", "blocked", "abandoned"
      ]
    },
    "role": {"type": "string"},
    "run_id": {"type": "string", "pattern": "^run_"},
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "updated_at": {"type": "string", "default": ""},
    "summary": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "default": ""},
    "lease": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "leaser": {"type": "string"},
        "leased_at": {"type": "string"},
        "expires_at": {"type": "string"},
        "lease_token": {"type": "string"}
      }
    },
    "dependencies": {
      "type": "array",
      "items": {"type": "string", "pattern": "^tsk_"}
    },
    "inputs": {"type": "array", "items": {"type": "string"}},
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "id"],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "source", "claim", "entity", "gap", "conflict",
              "decision", "report"
            ]
          },
          "id": {"type": "string"}
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "budget": {"type": "object"},
        "idempotency_key": {"type": "string"},
        "retries": {"type": "integer", "minimum": 0},
        "circuit_breaker": {
          "enum": ["open", "half-open", "closed"],
          "default": "closed"
        }
      }
    },
    "result": {
      "enum": ["ok", "warning", "error", "skipped"],
      "default": "ok"
    },
    "failure_reason": {"type": "string", "default": ""},
    "handoff_id": {"type": "string", "pattern": "^hnd_", "default": ""},
    "tags": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"}
    }
  }
}
