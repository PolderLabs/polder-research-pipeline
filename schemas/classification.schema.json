{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polder.dev/schemas/classification.schema.json",
  "title": "Classification decision record",
  "description": "Immutable provenance for an automatic metadata classification.",
  "type": "object",
  "required": ["id", "schema_version", "record_key", "target_kind", "target_id", "input_sha256", "taxonomy_sha256", "taxonomy_version", "taxonomy_snapshot", "provider", "requested_model", "model", "endpoint_identity", "questions", "category", "category_confidence", "tag_probabilities", "proposed_tags", "threshold", "answers", "disposition", "elapsed_ms", "created_at"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^cls_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "schema_version": {"type": "integer", "const": 1},
    "record_key": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target_kind": {"enum": ["source", "claim", "entity", "segment", "note"]},
    "target_id": {"type": "string", "minLength": 1},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "taxonomy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "taxonomy_version": {"type": "string", "minLength": 1},
    "taxonomy_snapshot": {"type": "object"},
    "provider": {"enum": ["rules", "jev", "laya"]},
    "requested_model": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "endpoint_identity": {"enum": ["typesafe-api", "local-process", "built-in"]},
    "questions": {"type": "object"},
    "category": {"type": ["string", "null"]},
    "category_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "tag_probabilities": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}},
    "proposed_tags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"}},
    "threshold": {"type": "number", "minimum": 0, "maximum": 1},
    "answers": {"type": "object"},
    "disposition": {"enum": ["accepted", "review_required", "failed"]},
    "error": {"type": "string", "maxLength": 500},
    "elapsed_ms": {"type": "integer", "minimum": 0},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
