{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://polder.dev/schemas/extraction.schema.json",
  "title": "Structured data extraction", "type": "object", "additionalProperties": false,
  "required": ["id", "schema_version", "run_id", "protocol_id", "protocol_sha256", "candidate_id", "source_id", "reviewer_id", "field", "status", "rationale", "record_kind", "recorded_at"],
  "properties": {
    "id": {"type": "string", "pattern": "^ext_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "schema_version": {"type": "integer", "const": 1}, "run_id": {"type": "string", "pattern": "^run_"},
    "protocol_id": {"type": "string", "pattern": "^prm_"}, "protocol_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_id": {"type": "string", "pattern": "^can_"}, "source_id": {"type": "string", "pattern": "^src_"},
    "reviewer_id": {"type": "string", "minLength": 1}, "field": {"type": "string", "minLength": 1},
    "status": {"enum": ["reported", "not_reported", "unclear"]}, "value": {"type": "string"},
    "segment_id": {"type": "string", "pattern": "^seg_"}, "rationale": {"type": "string", "minLength": 1},
    "record_kind": {"enum": ["independent", "adjudication"]},
    "resolves_extraction_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "pattern": "^ext_"}},
    "recorded_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "reported"}}, "required": ["status"]}, "then": {"required": ["value", "segment_id"], "properties": {"value": {"minLength": 1}}}},
    {"if": {"properties": {"record_kind": {"const": "adjudication"}}, "required": ["record_kind"]}, "then": {"required": ["resolves_extraction_ids"]}}
  ]
}
