{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://polder.dev/schemas/appraisal.schema.json",
  "title": "Evidence appraisal", "type": "object", "additionalProperties": false,
  "required": ["id", "schema_version", "run_id", "protocol_id", "protocol_sha256", "candidate_id", "source_id", "reviewer_id", "instrument", "overall_judgement", "domains", "limitations", "completed_at"],
  "properties": {
    "id": {"type": "string", "pattern": "^app_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "schema_version": {"type": "integer", "const": 1}, "run_id": {"type": "string", "pattern": "^run_"},
    "protocol_id": {"type": "string", "pattern": "^prm_"}, "protocol_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_id": {"type": "string", "pattern": "^can_"}, "source_id": {"type": "string", "pattern": "^src_"},
    "reviewer_id": {"type": "string", "minLength": 1}, "instrument": {"type": "string", "minLength": 1}, "instrument_version": {"type": "string", "minLength": 1}, "instrument_reference": {"type": "string", "minLength": 1},
    "overall_judgement": {"type": "string", "minLength": 1},
    "domains": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name", "judgement", "rationale"], "additionalProperties": false, "properties": {"name": {"type": "string", "minLength": 1}, "judgement": {"type": "string", "minLength": 1}, "rationale": {"type": "string", "minLength": 1}}}},
    "limitations": {"type": "array", "items": {"type": "string"}}, "completed_at": {"type": "string", "format": "date-time"}
  }
}
