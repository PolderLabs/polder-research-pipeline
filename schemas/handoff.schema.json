{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polder.dev/schemas/handoff.schema.json",
  "title": "Handoff record",
  "description": "Typed handoff between two roles (AUDIT.md §21).",
  "type": "object",
  "required": ["id", "schema_version", "from_role", "to_role", "status", "created_at", "summary"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^hnd_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "schema_version": {"type": "integer", "const": 1},
    "from_role": {"type": "string"},
    "to_role": {"type": "string"},
    "status": {
      "enum": ["open", "accepted", "rejected", "expired"]
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "accepted_at": {"type": "string", "default": ""},
    "expires_at": {"type": "string", "default": ""},
    "summary": {"type": "string", "minLength": 1},
    "context": {"type": "object"},
    "artifacts": {
      "type": "array",
      "items": {"type": "string"}
    },
    "task_id": {"type": "string", "pattern": "^tsk_", "default": ""},
    "run_id": {"type": "string", "pattern": "^run_", "default": ""},
    "rejection_reason": {"type": "string", "default": ""}
  }
}
