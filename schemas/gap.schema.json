{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polder.dev/schemas/gap.schema.json",
  "title": "Gap record",
  "description": "An explicit gap in the knowledge base (AUDIT.md §27).",
  "type": "object",
  "required": ["id", "schema_version", "description", "status", "created_at"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^gap_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "schema_version": {"type": "integer", "const": 1},
    "description": {"type": "string", "minLength": 1},
    "status": {
      "enum": ["open", "investigating", "filled", "deferred", "wontfix"]
    },
    "question": {"type": "string", "default": ""},
    "topic": {"type": "string", "default": ""},
    "priority": {
      "enum": ["low", "medium", "high", "critical"],
      "default": "medium"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "updated_at": {"type": "string", "default": ""},
    "filled_by_claim_id": {"type": "string", "pattern": "^clm_", "default": ""},
    "related_question_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^qst_"}
    },
    "notes": {"type": "string", "default": ""}
  }
}
