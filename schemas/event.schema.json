{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polder.dev/schemas/event.schema.json",
  "title": "Event record",
  "description": "Append-only event log of agent actions (AUDIT.md §19).",
  "type": "object",
  "required": ["id", "event_type", "actor", "timestamp", "instruction_version", "code_revision"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^evt_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "event_type": {
      "enum": [
        "run.started", "run.finished", "run.failed", "run.aborted",
        "task.created", "task.leased", "task.progressed", "task.completed", "task.failed", "task.handed_off",
        "source.discovered", "source.acquired", "source.hash-verified",
        "source.refreshed", "source.retracted",
        "segment.created", "segment.flagged",
        "claim.drafted", "claim.verified", "claim.disputed",
        "claim.superseded", "claim.refuted",
        "entity.discovered", "entity.merged", "entity.aliased",
        "gap.detected", "gap.filled", "gap.deferred",
        "decision.created", "decision.accepted", "decision.reopened",
        "maintenance.triggered", "maintenance.completed",
        "schema.proposed", "schema.applied", "schema.rejected",
        "state.rebuilt", "health.computed"
      ]
    },
    "actor": {"type": "string", "minLength": 1},
    "role": {"type": "string", "default": ""},
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "instruction_version": {"type": "string", "default": ""},
    "config_version": {"type": "string", "default": ""},
    "code_revision": {"type": "string", "default": ""},
    "run_id": {"type": "string", "pattern": "^run_", "default": ""},
    "task_id": {"type": "string", "pattern": "^tsk_", "default": ""},
    "action": {"type": "string", "default": ""},
    "inputs": {"type": "object"},
    "targets": {
      "type": "array",
      "items": {"type": "string"}
    },
    "summary": {"type": "string", "default": ""},
    "result": {
      "enum": ["ok", "warning", "error", "skipped"],
      "default": "ok"
    },
    "artifacts": {
      "type": "array",
      "items": {"type": "string"}
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sanitized_message": {"type": "string"},
        "category": {
          "enum": ["transient", "validation", "authorization", "internal", "external"]
        }
      }
    },
    "metadata": {"type": "object"}
  }
}
