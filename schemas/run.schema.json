{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polder.dev/schemas/run.schema.json",
  "title": "Run record",
  "description": "One research run groups related tasks against a brief (AUDIT.md §15).",
  "type": "object",
  "required": ["id", "schema_version", "run_status", "created_at", "brief"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^run_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "schema_version": {"type": "integer", "const": 1},
    "run_status": {
      "enum": ["draft", "active", "paused", "completed", "aborted", "failed"]
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "started_at": {"type": "string", "default": ""},
    "finished_at": {"type": "string", "default": ""},
    "owner": {"type": "string", "default": ""},
    "research_method": {
      "enum": ["continuous_intelligence", "systematic_evidence_review"],
      "default": "continuous_intelligence"
    },
    "protocol_id": {"type": "string", "pattern": "^prm_"},
    "protocol_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "brief": {
      "type": "object",
      "required": ["question"],
      "additionalProperties": false,
      "properties": {
        "question": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "default": ""},
        "out_of_scope": {
          "type": "array",
          "items": {"type": "string"}
        },
        "questions": {
          "type": "array",
          "items": {"type": "string"}
        },
        "definition_of_done": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "task_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^tsk_"}
    },
    "outputs": {
      "type": "array",
      "items": {"type": "string"}
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tokens": {"type": "integer", "minimum": 0},
        "wallclock_seconds": {"type": "integer", "minimum": 0},
        "tool_calls": {"type": "integer", "minimum": 0}
      }
    },
    "tags": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"}
    }
  },
  "allOf": [{
    "if": {"properties": {"research_method": {"const": "systematic_evidence_review"}, "run_status": {"enum": ["active", "completed"]}}, "required": ["research_method", "run_status"]},
    "then": {"required": ["protocol_id", "protocol_sha256"]}
  }]
}
