{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polder.dev/schemas/evidence.schema.json",
  "title": "Evidence edge record",
  "description": "A typed, locatable relationship from a claim to source evidence (AUDIT.md §10.10 and P4).",
  "type": "object",
  "required": [
    "id",
    "schema_version",
    "claim_id",
    "source_id",
    "relation",
    "directness",
    "confidence",
    "locator",
    "created_at"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^evd_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "schema_version": {"type": "integer", "const": 1},
    "claim_id": {"type": "string", "pattern": "^clm_"},
    "source_id": {"type": "string", "pattern": "^src_"},
    "segment_id": {"type": "string", "pattern": "^seg_"},
    "relation": {
      "enum": [
        "supports",
        "contradicts",
        "partially-supports",
        "qualifies",
        "contextualizes",
        "updates",
        "supersedes"
      ]
    },
    "directness": {
      "enum": ["primary", "secondary", "tertiary", "unknown"]
    },
    "confidence": {"enum": ["high", "medium", "low"]},
    "locator": {
      "type": "object",
      "required": ["scheme"],
      "additionalProperties": false,
      "properties": {
        "scheme": {
          "enum": [
            "page",
            "section",
            "paragraph",
            "line",
            "timestamp",
            "chapter",
            "anchor",
            "byte-offset",
            "sha256"
          ]
        },
        "value": {"type": "string"},
        "start": {"type": "string"},
        "end": {"type": "string"}
      }
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  }
}
