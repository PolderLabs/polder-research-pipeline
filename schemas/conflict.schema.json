{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polder.dev/schemas/conflict.schema.json",
  "title": "Conflict record",
  "description": "Tracks conflicting evidence between claims/sources.",
  "type": "object",
  "required": ["id", "schema_version", "claim_ids", "status", "created_at"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^cfl_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "schema_version": {"type": "integer", "const": 1},
    "claim_ids": {
      "type": "array",
      "minItems": 2,
      "items": {"type": "string", "pattern": "^clm_"}
    },
    "source_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^src_"}
    },
    "status": {
      "enum": ["open", "investigating", "resolved", "deferred"]
    },
    "severity": {
      "enum": ["low", "medium", "high", "critical"],
      "default": "medium"
    },
    "description": {"type": "string", "default": ""},
    "resolution": {"type": "string", "default": ""},
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "updated_at": {"type": "string", "default": ""}
  }
}
