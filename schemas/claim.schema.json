{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polder.dev/schemas/claim.schema.json",
  "title": "Claim record",
  "description": "A structured, verifiable statement extracted from a source (AUDIT.md §12-13).",
  "type": "object",
  "required": ["id", "schema_version", "statement", "claim_status", "created_at", "source_ids"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^clm_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "schema_version": {"type": "integer", "const": 1},
    "statement": {"type": "string", "minLength": 1},
    "claim_status": {
      "enum": ["draft", "verified", "disputed", "refuted", "superseded", "archived"]
    },
    "claim_kind": {
      "enum": [
        "factual", "quantitative", "comparative", "causal", "predictive",
        "definitional", "methodological", "opinion", "other"
      ],
      "default": "factual"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "updated_at": {"type": "string", "default": ""},
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^src_"}
    },
    "evidence": {
      "type": "array",
      "description": "Evidence edges linking this claim to supporting/contradicting evidence.",
      "items": {
        "type": "object",
        "required": ["relation", "source_id"],
        "additionalProperties": false,
        "properties": {
          "relation": {
            "enum": [
              "supports", "contradicts", "partially-supports",
              "qualifies", "contextualizes", "updates", "supersedes"
            ]
          },
          "source_id": {"type": "string", "pattern": "^src_"},
          "segment_id": {"type": "string", "pattern": "^seg_", "default": ""},
          "directness": {
            "enum": ["primary", "secondary", "tertiary", "unknown"],
            "default": "unknown"
          },
          "confidence": {
            "enum": ["high", "medium", "low"],
            "default": "medium"
          },
          "locator": {"type": "string", "default": ""}
        }
      }
    },
    "entities": {
      "type": "array",
      "items": {"type": "string", "pattern": "^ent_"}
    },
    "topic": {"type": "string", "default": ""},
    "scope": {"type": "string", "default": ""},
    "valid_as_of": {"type": "string", "default": ""},
    "freshness_status": {
      "enum": ["fresh", "aging", "stale", "unknown"],
      "default": "unknown"
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": ["pending", "verified", "disputed", "failed", "skipped"],
          "default": "pending"
        },
        "verified_at": {"type": "string", "default": ""},
        "verified_by": {"type": "string", "default": ""},
        "checks_performed": {
          "type": "array",
          "items": {
            "enum": [
              "source-supports-claim", "locator-valid", "version-date-unit",
              "scope-matches", "source-independence", "primary-evidence-checked",
              "contradicting-evidence-sought", "freshness-checked"
            ]
          }
        },
        "notes": {"type": "string", "default": ""}
      }
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "high_impact": {"type": "boolean", "default": false},
        "decision_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "^dec_"}
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"}
    },
    "classification_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^cls_"}},
    "classification_status": {"enum": ["accepted", "review_required", "failed", "disabled"]},
    "classification_error": {"type": "string", "maxLength": 500},
    "classification_dimensions": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "superseded_by": {"type": "string", "pattern": "^clm_", "default": ""},
    "conflict_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^cfl_"}
    }
  }
}
